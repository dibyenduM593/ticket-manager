# Copy to .env and fill in. .env is gitignored; never commit it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
TRIAGE_MODEL=claude-sonnet-5
TRIAGE_PROVIDER=anthropic
TRIAGE_CASSETTE_DIR=tests/cassettes

# record | replay | off
#   record - call the live API and write cassettes
#   replay - serve from cassettes only, never touch the network (no API key needed)
#   off    - call the live API, write nothing
TRIAGE_CASSETTE_MODE=off
